DATABASE_URL="mysql://root:password@localhost:3306/eleaningv2"
JWT_SECRET_KEY="your-super-secret-jwt-key"
JWT_EXPIRES_IN="3600s"

# React frontend origin allowed to call this API (CORS)
FRONTEND_URL="http://localhost:3001"

# Google OAuth2 Configuration — get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Optional: path to a Google Service Account JSON key with Drive API access.
# When set, confirming payment for a paid enrollment automatically grants the
# student's Google account "reader" permission on each lesson video's Drive
# file (mirrors phuongnh2208/google-drive-video-demo). The Drive
# files/folders must be shared with the service account's email as Editor.
# If unset, this step is skipped and Drive files must instead be set to
# "Anyone with the link" for playback to work.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=""

# Public enrollment payment guidance email (bank transfer info, not secret)
PAYMENT_BANK_ACCOUNT_NAME="Your Company Name"
PAYMENT_BANK_ACCOUNT_NUMBER="0000000000"
PAYMENT_BANK_NAME="Your Bank"
CLASS_SCHEDULE_INFO="Class format/schedule text shown in the payment guidance email"